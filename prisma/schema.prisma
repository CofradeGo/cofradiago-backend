generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Hermandad {
  id            Int     @id @default(autoincrement())
  name          String
  domain        String  @unique
  officialEmail String? // correo institucional de la hermandad
  logoUrl       String?
  users         User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hermanos Hermano[]
}

enum UserRole {
  DMG
  AUXILIAR
}

model User {
  id          Int       @id @default(autoincrement())
  username    String    @unique
  password    String
  role        UserRole
  email       String? // correo corporativo opcional
  hermandad   Hermandad @relation(fields: [hermandadId], references: [id])
  hermandadId Int
  isActive    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordResetTokens PasswordResetToken[]

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  tokenHash  String
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  deviceInfo String?  // opcional: user-agent / etiqueta del dispositivo
  ip         String?  // opcional: ip desde la que se creó
}


model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String // guardamos SHA-256 (o similar) del token real
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // relación con User
  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@index([tokenHash]) // índice para búsquedas por hash
}

model Hermano {
  id                 Int       @id @default(autoincrement())
  hermandadId        Int
  hermandad          Hermandad @relation(fields: [hermandadId], references: [id])
  numeroAntiguedad   Int
  nombre             String
  apellidos          String
  telefono           String
  email              String
  direccion          String
  fechaNacimiento    DateTime? // nullable
  fechaAltaHermandad DateTime
  activo             Boolean   @default(true)
  dni                String?   // 🆕 NUEVO CAMPO

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  puestos    PuestoHermano[]
  insignias   InsigniaHermano[]
  cargos     CargoHermano[]

  @@unique([hermandadId, numeroAntiguedad])
}

model Cofradia {
  id           Int       @id @default(autoincrement())
  hermandadId  Int
  nombre       String
  anio         Int
  tipo         String
  estado       CofradiaEstado @default(ABIERTA)
  cortejos     Cortejo[]
  puestos      Puesto[]
  insignias    Insignia[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([hermandadId, nombre, anio])
  cargos Cargo[]
  tramos Tramo[]
}

enum CofradiaEstado {
  ABIERTA
  CERRADA
}

/**
 * En qué se convierte una petición de sitio.
 *
 * Un hermano pide, la junta acepta o rechaza. `PENDIENTE` es el estado
 * con el que se registra todo lo nuevo, así que nadie se incorpora a la
 * procesión sin que alguien lo haya decidido.
 */
enum EstadoSolicitud {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

model Cortejo {
  id          Int      @id @default(autoincrement())
  cofradiaId  Int
  nombre      String
  orden       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cofradia    Cofradia @relation(fields: [cofradiaId], references: [id])

  insignias Insignia[]

  tramos Tramo[]
}

model Puesto {
  id          Int      @id @default(autoincrement())
  cofradiaId  Int
  nombre      String
  codigo      String? 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cofradia    Cofradia @relation(fields: [cofradiaId], references: [id])
  tramos      PuestoTramo[]
  hermanos    PuestoHermano[]

  @@unique([cofradiaId, nombre])
}

/**
 * Un puesto puede ocupar varios tramos de una procesión: los Cirios
 * aparecen en el segundo, en el tercero y en el cuarto, con personas
 * distintas en cada uno.
 */
model PuestoTramo {
  puestoId Int
  tramoId  Int

  /** Cuántas personas hacen falta para este puesto en este tramo. */
  plazas Int @default(1)

  puesto Puesto @relation(fields: [puestoId], references: [id], onDelete: Cascade)
  tramo  Tramo  @relation(fields: [tramoId], references: [id], onDelete: Cascade)

  @@id([puestoId, tramoId])
  @@index([tramoId])
}

/**
 * Hermanos que ocupan un puesto, en un tramo concreto.
 *
 * Un puesto admite varias personas (los Cirios son unos 17) y el mismo
 * puesto puede ocupar varios tramos, pero cada persona va en un solo
 * tramo y en un solo puesto de cada cofradía.
 *
 * `cofradiaId` está desnormalizado a propósito. Como `Hermano` cuelga
 * de la hermandad y no de la cofradía, sin copiar aquí el año no se
 * podría expresar esa restricción, y dejarla solo en el servicio
 * permitiría saltársela con una inserción directa.
 */
model PuestoHermano {
  id         Int      @id @default(autoincrement())
  puestoId   Int
  hermanoId  Int
  tramoId    Int
  cofradiaId Int
  /** PENDIENTE hasta que la junta acepta o rechaza la petición. */
  estado     EstadoSolicitud @default(PENDIENTE)
  /** Por qué se rechazó, o el acuerdo al que se llegó al aceptarla. */
  notas      String?

  puesto  Puesto  @relation(fields: [puestoId], references: [id], onDelete: Cascade)
  hermano Hermano @relation(fields: [hermanoId], references: [id], onDelete: Cascade)
  tramo   Tramo   @relation(fields: [tramoId], references: [id], onDelete: Cascade)

  @@unique([puestoId, hermanoId])
  // Una persona, un tramo y un puesto por cofradía: los tres a la vez.
  @@unique([hermanoId, cofradiaId])
  @@index([cofradiaId])
  @@index([tramoId])
  @@index([estado])
}

/**
 * Hermanos que piden llevar una insignia en un tramo.
 *
 * Mismo criterio que `PuestoHermano`: una persona, una insignia y un
 * tramo por cofradía. Las tres clases de petición son independientes,
 * así que un hermano puede pedir a la vez un puesto, una insignia y un
 * cargo, que es lo que se acordaba al montar la estructura.
 */
model InsigniaHermano {
  id         Int      @id @default(autoincrement())
  insigniaId Int
  hermanoId  Int
  tramoId    Int
  cofradiaId Int
  estado     EstadoSolicitud @default(PENDIENTE)
  notas      String?

  insignia Insignia @relation(fields: [insigniaId], references: [id], onDelete: Cascade)
  hermano  Hermano  @relation(fields: [hermanoId], references: [id], onDelete: Cascade)
  tramo    Tramo    @relation(fields: [tramoId], references: [id], onDelete: Cascade)

  @@unique([insigniaId, hermanoId])
  @@unique([hermanoId, cofradiaId])
  @@index([cofradiaId])
  @@index([tramoId])
  @@index([estado])
}

/**
 * Hermanos que piden un cargo en un tramo. Igual que los otros dos.
 */
model CargoHermano {
  id         Int      @id @default(autoincrement())
  cargoId    Int
  hermanoId  Int
  tramoId    Int
  cofradiaId Int
  estado     EstadoSolicitud @default(PENDIENTE)
  notas      String?

  cargo   Cargo   @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  hermano Hermano @relation(fields: [hermanoId], references: [id], onDelete: Cascade)
  tramo   Tramo   @relation(fields: [tramoId], references: [id], onDelete: Cascade)

  @@unique([cargoId, hermanoId])
  @@unique([hermanoId, cofradiaId])
  @@index([cofradiaId])
  @@index([tramoId])
  @@index([estado])
}

model Insignia {
  id          Int      @id @default(autoincrement())
  cofradiaId  Int
  nombre      String
  descripcion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  
  cofradia    Cofradia @relation(fields: [cofradiaId], references: [id])
  elementos   InsigniaElemento[]
  
  @@unique([cofradiaId, nombre])
  cortejos Cortejo[]
  tramos    InsigniaTramo[]
  hermanos  InsigniaHermano[]
}

/**
 * En qué tramos de la procesión sale una insignia, y con cuántas
 * personas.
 *
 * N:M porque un mismo estandarte puede abrir dos cortejos o quedar en
 * dos tramos, igual que un puesto.
 *
 * `plazas` cuenta a los que la llevan, no a las insignias: hay una sola
 * Cruz de Guía, pero la cargan cinco personas. La insignia sigue siendo
 * una pieza física única.
 */
model InsigniaTramo {
  insigniaId Int
  tramoId    Int

  /** Cuántas personas llevan esta insignia en este tramo. */
  plazas Int @default(1)

  insignia Insignia @relation(fields: [insigniaId], references: [id], onDelete: Cascade)
  tramo    Tramo    @relation(fields: [tramoId], references: [id], onDelete: Cascade)

  @@id([insigniaId, tramoId])
  @@index([tramoId])
}

model InsigniaElemento {
  id         Int      @id @default(autoincrement())
  insigniaId Int
  tipo       String   // "vara", "farol", "otro"
  cantidad   Int      @default(1)

  insignia   Insignia @relation(fields: [insigniaId], references: [id])
}

model Tramo {
  id          Int       @id @default(autoincrement())
  cofradiaId  Int
  cortejoId   Int
  nombre      String
  orden       Int       // Para saber qué tramo va primero
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  cofradia    Cofradia  @relation(fields: [cofradiaId], references: [id])
  // En cascada: los tramos son parte del cortejo, no una entidad aparte.
  // Sin esto, borrar un cortejo con tramos falla con "Foreign key
  // constraint violated", que es lo que pasaba. La cascada arrastra
  // también las asignaciones de puestos de esos tramos, porque quién
  // ocupa un puesto en un tramo que ya no existe no significa nada.
  cortejo     Cortejo   @relation(fields: [cortejoId], references: [id], onDelete: Cascade)
  puestos     PuestoTramo[]
  hermanos    PuestoHermano[]
  insignias   InsigniaTramo[]
  cargos      CargoTramo[]
  insigniasDeHermanos InsigniaHermano[]
  cargosDeHermanos    CargoHermano[]
  // Aquí más relaciones si luego asignamos cargos o insignias
}




model Cargo {
  id          Int      @id @default(autoincrement())
  cofradiaId  Int
  nombre      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cofradia    Cofradia @relation(fields: [cofradiaId], references: [id])
  tramos      CargoTramo[]
  hermanos    CargoHermano[]

  @@unique([cofradiaId, nombre])
}

/**
 * En qué tramos va un cargo de la hermandad, y con cuántas personas.
 *
 * N:M por lo mismo que en las insignias: un cargo puede repartirse en
 * varios tramos de la procesión.
 */
model CargoTramo {
  cargoId Int
  tramoId Int

  /**
   * Cuántas personas hacen falta para este cargo en este tramo.
   *
   * Al montar la estructura se sabe cuántos son aunque todavía no
   * quiénes: un tramo puede tener tres diputados de tramo y aún no
   * estar decididos. Quién ocupa cada plaza lo rellena el módulo de
   * papeleta de sitio.
   *
   * Se llama igual que en puestos e insignias porque significa lo
   * mismo en las tres: personas, no piezas.
   */
  plazas Int @default(1)

  cargo Cargo @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  tramo Tramo @relation(fields: [tramoId], references: [id], onDelete: Cascade)

  @@id([cargoId, tramoId])
  @@index([tramoId])
}

