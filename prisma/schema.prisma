generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Hermandad {
  id            Int     @id @default(autoincrement())
  name          String
  domain        String  @unique
  officialEmail String? // correo institucional de la hermandad
  logoUrl       String?
  users         User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hermanos Hermano[]
}

enum UserRole {
  DMG
  AUXILIAR
}

model User {
  id          Int       @id @default(autoincrement())
  username    String    @unique
  password    String
  role        UserRole
  email       String? // correo corporativo opcional
  hermandad   Hermandad @relation(fields: [hermandadId], references: [id])
  hermandadId Int
  isActive    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordResetTokens PasswordResetToken[]

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  tokenHash  String
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  deviceInfo String?  // opcional: user-agent / etiqueta del dispositivo
  ip         String?  // opcional: ip desde la que se creó
}


model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String // guardamos SHA-256 (o similar) del token real
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // relación con User
  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@index([tokenHash]) // índice para búsquedas por hash
}

model Hermano {
  id                 Int       @id @default(autoincrement())
  hermandadId        Int
  hermandad          Hermandad @relation(fields: [hermandadId], references: [id])
  numeroAntiguedad   Int
  nombre             String
  apellidos          String
  telefono           String
  email              String
  direccion          String
  fechaNacimiento    DateTime? // nullable
  fechaAltaHermandad DateTime
  activo             Boolean   @default(true)
  dni                String?   // 🆕 NUEVO CAMPO

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hermandadId, numeroAntiguedad])
}

