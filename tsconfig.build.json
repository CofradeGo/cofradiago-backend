{
  // Solo se compila src/. Sin este include, tsc se llevaría también
  // __tests__ y scripts/ y falla por rootDir.
  "include": ["src"],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    // Módulos y compatibilidad ESM
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,

    // El proyecto importa con extensión explícita (.ts), que ESM exige.
    // Al compilar, TypeScript la reescribe a .js en el dist.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    // Librerías y tipado
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ESNext"],

    // Output
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Reglas estrictas
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force"
  }
}
