// .env.test — configuración solo para los tests.
//
// En local los tests deben correr contra una base APARTE para no tocar
// tus datos de desarrollo. En CI no existe este fichero: allí el
// servicio de Postgres ya crea la base y se usa DATABASE_URL.
//
// Copia este fichero como .env.test y ajusta si tus credenciales difieren.

TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cofradiago_test