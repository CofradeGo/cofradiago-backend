# Puerto del servidor
PORT=3000

# Base de datos (PostgreSQL)
# Con Docker:  docker-compose up -d
# Sin Docker:  usar Postgres.app en el puerto 5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cofradiago
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cofradiago

# Secret para firmar los JWT (cámbialo en producción)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# URL del frontend (para CORS y enlaces de las papeletas)
FRONTEND_URL=http://localhost:5173

# Base pública del backend, usada para construir URLs de ficheros (/uploads/...)
APP_URL=http://localhost:3000